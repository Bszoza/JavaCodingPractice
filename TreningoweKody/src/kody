                new User("Ewa", "ewa@example.com")
        );
        String emailToFind = "jan@example.com";
        Optional<User> result = findByEmail(users, emailToFind);
        String output = result.isPresent() ? result.get().getEmail() : "Nie znaleziono";

            private static Optional<User> findByEmail(List <User> users,String email) {

                for(User user : users) {
                    if(user.getEmail().equalsIgnoreCase(email)) {
                        return Optional.of(user);
                    }
                }
                return Optional.empty();
            }
